t-emotion-cache-1jj3fbf e149qiiz1" data-testid="stHeader"><div class="stAppToolbar st-emotion-cache-14vh5up e149qiiz2" data-testid="stToolbar"><div class="st-emotion-cache-1j22a0y e149qiiz4"><div class="st-emotion-cache-jma0kd e149qiiz5"></div><div class="st-emotion-cache-scp8yw e149qiiz6"><div class="stToolbarActions st-emotion-cache-1p1m4ay epm40z22" data-testid="stToolbarActions"></div><div class="stAppDeployButton" data-testid="stAppDeployButton"><button kind="header" data-testid="stBaseButton-header" class="st-emotion-cache-1x5n7op e1w3uk7w14"><div class="st-emotion-cache-1wbqy5l e19wr9s00"><span>Deploy</span></div></button></div><span id="MainMenu" class="stMainMenu st-emotion-cache-czk5ss el5zzf54" data-testid="stMainMenu"><button kind="headerNoPadding" data-testid="stMainMenuButton" aria-label="Main menu" aria-haspopup="menu" aria-expanded="false" class="st-emotion-cache-6buas8 e1w3uk7w15"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="e1fmktau1 st-emotion-cache-nsoqg8 ex0cdmw0"><path fill="none" d="M0 0h24v24H0V0z"></path><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path></svg></button></span></div></div></div></header><main id="stMain" tabindex="0" class="stMain st-emotion-cache-170etyg e87roqt2" data-testid="stMain"><div class="stMainBlockContainer block-container st-emotion-cache-lhe5w4 e87roqt5" data-testid="stMainBlockContainer"><div direction="column" height="auto" class="stVerticalBlock st-emotion-cache-1ndxyp5 e1a2occc3" data-testid="stVerticalBlock"><div class="stElementContainer element-container st-emotion-cache-3pwa5w e1a2occc1" data-testid="stElementContainer" data-stale="false" width="100%" height="auto" overflow="visible"><div class="stMarkdown" data-testid="stMarkdown"><div class="st-emotion-cache-k2h9z6 e1o1x6gp2"><div class="st-emotion-cache-bzjstw e12uj6qz0" data-testid="stMarkdownContainer"><style>

/* ================================
   COSMIC VIOLET AI THEME
================================ */

/* Main application */
.stApp {
    background: linear-gradient(135deg, #080D1B 0%, #10172A 55%, #11102B 100%);
    color: #F8FAFC;
}

/* Main content */
.block-container {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 1450px;
}

/* Sidebar */
[data-testid="stSidebar"] {
    background: linear-gradient(180deg, #11132B 0%, #171433 100%);
    border-right: 1px solid #29264D;
}

[data-testid="stSidebar"] > div:first-child {
    padding-top: 1.5rem;
}

/* Sidebar text */
[data-testid="stSidebar"] p,
[data-testid="stSidebar"] label,
[data-testid="stSidebar"] span {
    color: #D8D9F0;
}

/* Branding */
.brand {
    font-size: 27px;
    font-weight: 800;
    color: #B69CFF;
}

.brand-subtitle {
    font-size: 13px;
    color: #A5A4C5;
}

/* Welcome section */
.welcome-title {
    font-size: 32px;
    font-weight: 750;
    color: #FFFFFF;
}

.welcome-subtitle {
    color: #A5B4CF;
    font-size: 16px;
}

.date-text {
    text-align: right;
    color: #A5B4CF;
    font-size: 13px;
}

/* Headings */
h1, h2, h3, h4 {
    color: #F8FAFC !important;
}

/* Paragraphs and labels */
.stMarkdown p,
.stMarkdown li,
.stMarkdown label {
    color: #D5DCEF;
}

/* Cards and containers */
[data-testid="stVerticalBlockBorderWrapper"] {
    background: #151E33;
    border: 1px solid #303B59;
    border-radius: 14px;
}

/* Buttons */
/* Premium Purple Buttons */
.stButton > button,
.stFormSubmitButton > button {
    background: linear-gradient(135deg, #7C3AED, #9333EA) !important;
    color: #FFFFFF !important;
    border: 1px solid #A78BFA !important;
    border-radius: 10px !important;
    min-height: 44px !important;
    font-weight: 700 !important;
    width: 100% !important;
    opacity: 1 !important;
    transition: all 0.2s ease;
}

.stButton > button:hover,
.stFormSubmitButton > button:hover {
    background: linear-gradient(135deg, #9333EA, #6D28D9) !important;
    color: #FFFFFF !important;
    border: 1px solid #C4B5FD !important;
    box-shadow: 0 0 18px rgba(139, 92, 246, 0.35);
}

/* Input fields */
.stTextInput input,
.stTextArea textarea,
.stNumberInput input {
    background-color: #111A2D !important;
    color: #F8FAFC !important;
    border: 1px solid #384665 !important;
    border-radius: 9px !important;
}

.stSelectbox div[data-baseweb="select"] > div {
    background-color: #111A2D;
    color: #F8FAFC;
    border-color: #384665;
}

/* Radio buttons and checkboxes */
.stRadio label,
.stCheckbox label {
    color: #D5DCEF !important;
}

/* Metrics */
[data-testid="stMetric"] {
    background: #151E33;
    border: 1px solid #303B59;
    border-radius: 13px;
    padding: 18px;
}

[data-testid="stMetricLabel"] {
    color: #A5B4CF !important;
}

[data-testid="stMetricValue"] {
    color: #FFFFFF !important;
}

/* Alerts */
.stAlert {
    border-radius: 12px;
}

/* Dataframes and tables */
[data-testid="stDataFrame"],
[data-testid="stTable"] {
    background-color: #151E33;
    border-radius: 10px;
}

/* Tabs */
.stTabs [data-baseweb="tab"] {
    color: #B9C4DA;
}

.stTabs [aria-selected="true"] {
    color: #C4B5FD !important;
    border-bottom-color: #8B5CF6 !important;
}

/* Dividers */
hr {
    border-color: #303B59;
}

/* Links */
a {
    color: #A78BFA !important;
}

/* Progress bars */
.stProgress > div > div > div > div {
    background: linear-gradient(90deg, #7C3AED, #38BDF8);
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: #0B1120;
}

::-webkit-scrollbar-thumb {
    background: #51417E;
    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: #8B5CF6;
}

/* Smooth transitions */
[data-testid="stVerticalBlockBorderWrapper"],
[data-testid="stMetric"] {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

[data-testid="stMetric"]:hover {
    border-color: #8060CF;
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.12);
}

/* Remove white Streamlit header */
[data-testid="stHeader"] {
    background: #0B1120 !important;
}

/* Make toolbar transparent */
[data-testid="stToolbar"] {
    background: transparent !important;
}

/* Hide the white decoration above the app */
[data-testid="stDecoration"] {
    background: transparent !important;
}

/* Dark top area */
header {
    background: #0B1120 !important;
}

/* Deploy and menu controls */
[data-testid="stHeader"] button {
    color: #F8FAFC !important;
}

.brand-container {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 12px 5px 26px 5px;
    margin-bottom: 24px;
    border-bottom: 1px solid #30294F;
}

.brand-logo {
    width: 52px;
    height: 52px;
    min-width: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #9333EA, #5B4BDB, #2563EB);
    border: 1px solid rgba(196, 181, 253, 0.4);
    border-radius: 16px;
    box-shadow: 0 5px 22px rgba(124, 58, 237, 0.35);
}

.brand-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.brand-name {
    color: #FFFFFF !important;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.7px;
    line-height: 1.2;
}

.brand-name span {
    color: #A78BFA;
}

.brand-subtitle {
    color: #A5A4C5 !important;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.4px;
    line-height: 1.4;
}

/* =================================
   PREMIUM SIDEBAR NAVIGATION
================================= */

/* Navigation container */
[data-testid="stSidebar"] div[role="radiogroup"] {
    gap: 8px;
}

/* Each navigation item */
[data-testid="stSidebar"] div[role="radiogroup"] label {
    background: transparent !important;
    border: 1px solid transparent !important;
    border-radius: 10px !important;
    padding: 10px 12px !important;
    margin: 2px 0 !important;
    transition: all 0.2s ease;
}

/* Hide radio circles */
[data-testid="stSidebar"] div[role="radiogroup"] label > div:first-child {
    display: none !important;
}

/* Navigation text */
[data-testid="stSidebar"] div[role="radiogroup"] label p {
    color: #C7C9E5 !important;
    font-size: 14px !important;
    font-weight: 550 !important;
}

/* Hover effect */
[data-testid="stSidebar"] div[role="radiogroup"] label:hover {
    background: #252044 !important;
    border-color: #493779 !important;
}

/* Selected navigation item */
[data-testid="stSidebar"] div[role="radiogroup"] label:has(input:checked) {
    background: linear-gradient(
        100deg,
        #512A91,
        #33245F
    ) !important;
    border: 1px solid #8855DC !important;
    box-shadow: 0 3px 14px rgba(124, 58, 237, 0.2);
}

/* Selected navigation text */
[data-testid="stSidebar"] div[role="radiogroup"] label:has(input:checked) p {
    color: #FFFFFF !important;
    font-weight: 700 !important;
}
/* Compact sidebar navigation */
[data-testid="stSidebar"] [role="radiogroup"] label > div:first-child {
    display: none !important;
}

[data-testid="stSidebar"] [role="radiogroup"] label {
    padding: 5px 10px !important;
    margin: 2px 0 !important;
    min-height: 38px !important;
    border-radius: 9px !important;
}

[data-testid="stSidebar"] [role="radiogroup"] label p {
    color: #C7C9E5 !important;
    font-size: 14px !important;
}

[data-testid="stSidebar"] [role="radiogroup"] label:has(input:checked) {
    background: #422477 !important;
    border: 1px solid #8855DC !important;
}

/* Button-based sidebar navigation */
[data-testid="stSidebar"] .stButton > button {
    background: transparent !important;
    border: 1px solid transparent !important;
    color: #D8D9F0 !important;
    text-align: left !important;
    border-radius: 10px !important;
    padding: 10px 14px !important;
    min-height: 42px !important;
    font-size: 14px !important;
    font-weight: 550 !important;
    box-shadow: none !important;
}

/* Hover */
[data-testid="stSidebar"] .stButton > button:hover {
    background: #292044 !important;
    border-color: #574184 !important;
    color: #FFFFFF !important;
}

/* Active button */
[data-testid="stSidebar"] .stButton > button[kind="primary"] {
    background: linear-gradient(100deg, #512A91, #33245F) !important;
    border: 1px solid #8855DC !important;
    color: #FFFFFF !important;
    box-shadow: 0 3px 14px rgba(124, 58, 237, 0.2) !important;
}
/* FINAL SIDEBAR POLISH */

[data-testid="stSidebar"] .stButton > button {
    border: 1px solid transparent !important;
    background: transparent !important;
    color: #D8D9F0 !important;
    border-radius: 9px !important;
    text-align: left !important;
    padding: 8px 12px !important;
    min-height: 40px !important;
    box-shadow: none !important;
}

[data-testid="stSidebar"] .stButton > button:hover {
    background: #252044 !important;
    border-color: #493779 !important;
}

[data-testid="stSidebar"] .stButton > button[kind="primary"] {
    background: linear-gradient(100deg, #512A91, #33245F) !important;
    border: 1px solid #8855DC !important;
    color: white !important;
}

/* Recommendation alert */
[data-testid="stAlert"] {
    background: #252044 !important;
    border: 1px solid #60449A !important;
    border-radius: 10px !important;
}

[data-testid="stAlert"] p,
[data-testid="stAlert"] div {
    color: #F1ECFF !important;
}

/* =================================
   DARK THEME FORM IMPROVEMENTS
================================= */

/* Form labels */
[data-testid="stWidgetLabel"] p {
    color: #E5DDFB !important;
    font-weight: 600 !important;
}

/* Text inputs and text areas */
[data-testid="stTextInput"] input,
[data-testid="stTextArea"] textarea {
    background: #182139 !important;
    color: #FFFFFF !important;
    border: 1px solid #6550A5 !important;
    border-radius: 9px !important;
}

/* Select boxes */
[data-testid="stSelectbox"] div[data-baseweb="select"] > div {
    background: #182139 !important;
    color: #FFFFFF !important;
    border-color: #6550A5 !important;
}

/* Number inputs */
[data-testid="stNumberInput"] input {
    background: #182139 !important;
    color: #FFFFFF !important;
    border-color: #6550A5 !important;
}

/* Placeholder text */
input::placeholder,
textarea::placeholder {
    color: #9BA5BD !important;
}

/* Buttons */
.stButton > button {
    background: linear-gradient(100deg, #7040D9, #923CE8) !important;
    color: #FFFFFF !important;
    border: 1px solid #A879FF !important;
    border-radius: 9px !important;
    font-weight: 600 !important;
}

/* FIX DROPDOWN SELECTED TEXT VISIBILITY */

[data-testid="stSelectbox"] [data-baseweb="select"] {
    background-color: #182139 !important;
    border: 1px solid #8060D8 !important;
    border-radius: 9px !important;
}

[data-testid="stSelectbox"] [data-baseweb="select"] div[class*="singleValue"],
[data-testid="stSelectbox"] [data-baseweb="select"] div[class*="SingleValue"] {
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
    opacity: 1 !important;
}

[data-testid="stSelectbox"] [data-baseweb="select"] input {
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
    caret-color: #FFFFFF !important;
}

[data-testid="stSelectbox"] [data-baseweb="select"] svg {
    fill: #FFFFFF !important;
}
/* Fix all button text visibility */
.stButton > button,
.stButton > button p {
    color: #FFFFFF !important;
    opacity: 1 !important;
}

/* Button appearance */
.stButton > button {
    background: linear-gradient(90deg, #7040D9, #923CE8) !important;
    border: 1px solid #A879FF !important;
}

/* Force dark styling on Streamlit dropdown */
div[data-testid="stSelectbox"] div[data-baseweb="select"],
div[data-testid="stSelectbox"] div[role="combobox"] {
    background-color: #182139 !important;
    color: #FFFFFF !important;
}

div[data-testid="stSelectbox"] div[data-baseweb="select"] * {
    color: #FFFFFF !important;
}

div[data-testid="stSelectbox"] svg {
    fill: #FFFFFF !important;
}

/* Knowledge Level dropdown - readable styling */
div[data-testid="stSelectbox"] div[data-baseweb="select"] {
    background-color: #FFFFFF !important;
    border: 1px solid #8060D8 !important;
    border-radius: 8px !important;
}

div[data-testid="stSelectbox"] div[data-baseweb="select"] * {
    color: #172033 !important;
}

div[data-testid="stSelectbox"] input {
    color: #172033 !important;
    -webkit-text-fill-color: #172033 !important;
}

/* Dropdown options */
ul[role="listbox"] li {
    background-color: #FFFFFF !important;
    color: #172033 !important;
}
/* Learning Path - Professional Controls */

.stButton > button {
    background: linear-gradient(135deg, #7C3AED, #9333EA) !important;
    color: #FFFFFF !important;
    border: 1px solid #A78BFA !important;
    border-radius: 10px !important;
    font-weight: 700 !important;
    min-height: 44px;
}

.stButton > button:hover {
    background: linear-gradient(135deg, #6D28D9, #7E22CE) !important;
    border: 1px solid #C4B5FD !important;
}

/* Dropdown styling */
div[data-baseweb="select"] > div {
    background-color: #19243B !important;
    border: 1px solid #6551A8 !important;
    color: #FFFFFF !important;
}

div[data-baseweb="select"] * {
    color: #FFFFFF !important;
}
/* ===== PREMIUM 10/10 LEARNING COACH THEME ===== */

/* Main background */
.stApp {
    background: linear-gradient(
        135deg,
        #0B1020,
        #10172A,
        #11182B
    ) !important;
    color: #F8FAFC !important;
}

/* Main headings */
h1, h2, h3 {
    color: #F8FAFC !important;
    font-weight: 750 !important;
    letter-spacing: -0.5px;
}

/* Sidebar */
[data-testid="stSidebar"] {
    background: linear-gradient(
        180deg,
        #111329,
        #191532
    ) !important;
    border-right: 1px solid #292345;
}

/* Cards */
div[data-testid="stVerticalBlockBorderWrapper"] {
    background: #151D32;
    border: 1px solid #303B59;
    border-radius: 16px;
}

/* Text inputs */
.stTextInput input,
.stTextArea textarea,
.stNumberInput input {
    background: #19243B !important;
    color: #FFFFFF !important;
    border: 1px solid #6551A8 !important;
    border-radius: 10px !important;
}

/* Labels */
.stTextInput label,
.stTextArea label,
.stNumberInput label,
.stSelectbox label {
    color: #DCE3F5 !important;
    font-weight: 600 !important;
}

/* Buttons */
.stButton > button,
.stFormSubmitButton > button {
    background: linear-gradient(
        135deg,
        #7C3AED,
        #9333EA
    ) !important;
    color: white !important;
    border: 1px solid #A78BFA !important;
    border-radius: 11px !important;
    font-weight: 700 !important;
    min-height: 44px !important;
    transition: all 0.2s ease;
}

.stButton > button:hover,
.stFormSubmitButton > button:hover {
    background: linear-gradient(
        135deg,
        #9333EA,
        #6D28D9
    ) !important;
    box-shadow: 0 0 18px rgba(139,92,246,0.35);
    transform: translateY(-1px);
}

/* Dropdown */
div[data-baseweb="select"] > div {
    background: #19243B !important;
    border: 1px solid #6551A8 !important;
    border-radius: 10px !important;
}

div[data-baseweb="select"] * {
    color: #FFFFFF !important;
}

/* Progress bars */
.stProgress > div > div > div {
    background: linear-gradient(
        90deg,
        #7C3AED,
        #A78BFA
    ) !important;
}

/* Dividers */
hr {
    border-color: #29334D !important;
}

/* =====================================
   PREMIUM INLINE CODE HIGHLIGHTS
   ===================================== */

.stMarkdown p code,
.stMarkdown li code,
.stMarkdown h1 code,
.stMarkdown h2 code,
.stMarkdown h3 code {
    background: linear-gradient(
        135deg,
        #251B46,
        #34205D
    ) !important;

    color: #D8B4FE !important;

    border: 1px solid #8055D9 !important;
    border-radius: 7px !important;

    padding: 4px 9px !important;

    font-family: "Consolas", monospace !important;
    font-size: 0.92em !important;
    font-weight: 650 !important;

    box-shadow:
        0 0 8px rgba(139, 92, 246, 0.16);

    transition: all 0.2s ease;
}

/* Subtle hover effect */

.stMarkdown p code:hover,
.stMarkdown li code:hover {
    background: #493078 !important;
    border-color: #C4B5FD !important;

    box-shadow:
        0 0 12px rgba(167, 139, 250, 0.35);
}

/* =====================================
   DAY-WISE LEARNING SCHEDULE
   ===================================== */

.stMarkdown h2 {
    color: #C4B5FD !important;
    font-size: 27px !important;
    font-weight: 800 !important;
    padding: 14px 0 10px 0 !important;
    border-bottom: 1px solid rgba(167, 139, 250, 0.25);
    margin-top: 28px !important;
}

.stMarkdown h3 {
    color: #E9D5FF !important;
    font-size: 21px !important;
    font-weight: 700 !important;
    margin-top: 20px !important;
}

.stMarkdown ul {
    padding-left: 25px !important;
}

.stMarkdown li {
    color: #E2E8F0 !important;
    line-height: 1.85 !important;
    margin-bottom: 5px !important;
}

.stMarkdown hr {
    border-color: rgba(167, 139, 250, 0.25) !important;
}

/* =====================================
   PREMIUM LEARNING CONTENT
   ===================================== */

/* Learning schedule section headings */
.stMarkdown h3 {
    background: linear-gradient(
        135deg,
        rgba(124, 58, 237, 0.16),
        rgba(147, 51, 234, 0.06)
    );

    border-left: 4px solid #A78BFA;
    border-radius: 8px;

    padding: 12px 16px !important;
    margin-top: 24px !important;

    color: #DDD6FE !important;
}

/* Learning content */
.stMarkdown li {
    color: #E2E8F0 !important;
    line-height: 1.9 !important;
    padding-left: 4px;
}

/* Strong text labels */
.stMarkdown strong {
    color: #C4B5FD !important;
    font-weight: 750 !important;
}

/* Horizontal separators */
.stMarkdown hr {
    border: none !important;
    border-top: 1px solid rgba(167, 139, 250, 0.25) !important;
    margin: 28px 0 !important;
}

/* =====================================
   PREMIUM DASHBOARD STATISTIC CARDS
   ===================================== */

[data-testid="stMetric"] {
    background: linear-gradient(
        145deg,
        #19213A,
        #211A42
    ) !important;

    border: 1px solid #493477 !important;
    border-radius: 16px !important;

    padding: 22px 20px !important;

    box-shadow:
        0 5px 18px rgba(0, 0, 0, 0.20);

    transition: all 0.25s ease;
}

/* Hover effect */
[data-testid="stMetric"]:hover {
    transform: translateY(-4px);

    border-color: #A78BFA !important;

    box-shadow:
        0 8px 25px rgba(124, 58, 237, 0.22);
}

/* Metric labels */
[data-testid="stMetricLabel"] {
    color: #C4B5FD !important;
    font-weight: 650 !important;
}

/* Metric values */
[data-testid="stMetricValue"] {
    color: #FFFFFF !important;
    font-size: 2.2rem !important;
    font-weight: 800 !important;
}

/* Metric icons and delta text */
[data-testid="stMetricDelta"] {
    color: #A78BFA !important;
}

/* CONTENT LIBRARY RESOURCE BUTTONS */

[data-testid="stLinkButton"] a {
    background: linear-gradient(135deg, #7C3AED, #5B35B5) !important;
    color: #FFFFFF !important;
    border: 1px solid #A78BFA !important;
    border-radius: 10px !important;
    font-weight: 650 !important;
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.22) !important;
    transition: all 0.2s ease !important;
}

[data-testid="stLinkButton"] a:hover {
    background: linear-gradient(135deg, #8B5CF6, #6D28D9) !important;
    color: #FFFFFF !important;
    border-color: #C4B5FD !important;
    transform: translateY(-2px);
}
/* Lesson Progress dropdown selected text */
div[data-testid="stSelectbox"]:has(label) div[data-baseweb="select"] span {
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
}


